{
  "opencollection": "1.0.0",
  "info": {
    "name": "Portal Report API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get report(s) by organization id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/portalapi/Report/ReportGetByOrganizationId"
          },
          "docs": "Get report(s) by organization id."
        },
        {
          "info": {
            "name": "Generate report data.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/portalapi/Report/ReportGetDynamicData",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate report data."
        }
      ]
    }
  ],
  "bundled": true
}