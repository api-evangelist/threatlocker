{
  "opencollection": "1.0.0",
  "info": {
    "name": "Portal Organization API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Auth Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/portalapi/Organization/OrganizationGetAuthKeyById"
          },
          "docs": "Get Auth Key"
        },
        {
          "info": {
            "name": "Generate Auth Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/portalapi/Organization/OrganizationUpdateAuthKeyById"
          },
          "docs": "Generate Auth Key"
        },
        {
          "info": {
            "name": "Get Organizations For Move Computers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/portalapi/Organization/OrganizationGetForMoveComputers",
            "params": [
              {
                "name": "searchText",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Organizations For Move Computers"
        }
      ]
    }
  ],
  "bundled": true
}